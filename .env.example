# Copy to .env.local for local development (.local files are git-ignored).
# On Netlify, set these under Site configuration > Environment variables.

# zen_admin backend, used for ?ref= referral validation and referral sign-up
VITE_ZEN_ADMIN_API_URL=

# 'true' switches booking from Calendly to the patient portal. Anything else, or unset, = off.
VITE_PATIENT_PORTAL_ENABLED=false
# Patient portal origin (staging: https://app-staging.zenforcewellness.com)
VITE_PATIENT_PORTAL_URL=https://app.zenforcewellness.com
